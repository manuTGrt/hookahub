# ==============================================================================
# Hookahub - Configuración de Entorno (.env)
# ==============================================================================
# Copia este archivo como .env y completa con tus credenciales reales:
#   cp .env.example .env
#
# Para ejecutar o compilar la app pasando este archivo:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#   flutter build ipa --dart-define-from-file=.env
# ==============================================================================

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth Configuration (Google Sign-In)
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
